          "def": "FOREIGN KEY (\"categoryId\") REFERENCES categories(id) ON UPDATE CASCADE ON DELETE RESTRICT"
        },
        {
          "conname": "books_compareAtPrice_above_price_check",
          "def": "CHECK (((\"compareAtPrice\" IS NULL) OR (\"compareAtPrice\" > price)))"
