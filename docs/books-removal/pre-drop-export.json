          "def": "CHECK ((pages >= 1))"
        },
        {
          "conname": "books_pkey",
          "def": "PRIMARY KEY (id)"
        },
        {
          "conname": "books_price_check",
          "def": "CHECK ((price >= 0))"
        },
        {
          "conname": "books_publishedYear_check",
          "def": "CHECK ((\"publishedYear\" >= 1))"
        },
        {
          "conname": "books_publisherId_fkey",
          "def": "FOREIGN KEY (\"publisherId\") REFERENCES publishers(id) ON UPDATE CASCADE ON DELETE RESTRICT"
        },
        {
          "conname": "books_rating_check",
          "def": "CHECK (((rating >= (0)::double precision) AND (rating <= (5)::double precision)))"
        },
        {
          "conname": "books_reviewsCount_check",
          "def": "CHECK ((\"reviewsCount\" >= 0))"
        },
        {
          "conname": "books_stock_check",
          "def": "CHECK ((stock >= 0))"
        }
