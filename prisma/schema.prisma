// Noqta Store — database schema, modelled from src/types/index.ts.
//
// Conventions
// - Editorial content (books, categories, authors) carries one column per
//   locale: the store ships exactly two, so a column pair beats a join.
// - Customer-written content (addresses, reviews) is a single column — a
//   reader types one string, not a translation pair.
// - Money is stored as whole Iraqi dinars; IQD has no minor units.
// - Enum values mirror the TypeScript unions exactly, so no mapping layer
//   is needed between Prisma Client and the existing app types.
//
// Connection URLs live in prisma7.config.ts (Prisma 7 removed them here).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum BookTag {
  bestseller
  new
  featured
  award
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  card
  wallet
}

enum ShippingMethod {
  standard
  express
  pickup
}

enum ReviewStatus {
  pending
  published
  rejected
}

enum CustomerStatus {
  active
  blocked
}

enum CustomerRole {
  customer
  admin
}

enum CouponType {
  percentage
  fixed
}

enum ContactStatus {
  new
  read
}

// ------------------------------------------------------------------
// Catalogue
// ------------------------------------------------------------------

/// The school-book catalogue's tree: stages hold grades, grades may hold
/// branches, and any of them may grow another level. A row with no parent
/// is a top-level branch.
model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameAr        String
  descriptionAr String
  /// Lucide icon name; the UI layer owns the mapping.
  icon          String
  /// The branch this one hangs under; null for a top-level branch.
  parentId      String?
  /// Position among siblings — the grades read in school order, not by size.
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children Category[] @relation("CategoryTree")

  books Book[]

  /// Teachers whose subject this branch is.
  authors Author[] @relation("AuthorSubject")

  /// A name is unique among siblings: «العلمي» hangs under every preparatory
  /// grade, but never twice under the same one. The migration declares the
  /// index NULLS NOT DISTINCT so two top-level branches cannot share a name
  /// either — Postgres would otherwise treat each null parent as distinct.
  @@unique([parentId, nameAr])
  @@index([parentId])
  @@map("categories")
}

/// The handouts' own tree, shaped exactly like Category and kept in its own
/// table: the two catalogues are filed apart, so a branch added to one does
/// not appear in the other.
model HandoutCategory {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameAr        String
  descriptionAr String
  /// Lucide icon name; the UI layer owns the mapping.
  icon          String
  /// The branch this one hangs under; null for a top-level branch.
  parentId      String?
  /// Position among siblings — the grades read in school order, not by size.
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   HandoutCategory?  @relation("HandoutCategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children HandoutCategory[] @relation("HandoutCategoryTree")

  handouts Handout[]

  /// Same rule as Category, same NULLS NOT DISTINCT in the migration.
  @@unique([parentId, nameAr])
  @@index([parentId])
  @@map("handout_categories")
}

model Publisher {
  id            String   @id @default(cuid())
  slug          String   @unique
  /// The slug alone never caught a repeated name: the seeded slugs are Latin
  /// and a name typed into the panel makes an Arabic one, so «دار الشروق»
  /// re-entered used to become a second row. The name itself is the key.
  nameAr        String   @unique
  descriptionAr String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  books Book[]

  handouts Handout[]

  @@map("publishers")
}

model Author {
  id        String   @id @default(cuid())
  slug      String   @unique
  /// Unique for the same reason as Publisher.nameAr. Two teachers who really
  /// share a name are told apart by a suffix in the panel, not by a second row.
  nameAr    String   @unique
  /// The category the teacher's subject is filed under; null when none is on record.
  subjectId String?
  bioAr     String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Category? @relation("AuthorSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  books Book[]

  handouts Handout[]

  @@index([subjectId])
  @@map("authors")
}

model Book {
  id             String    @id @default(cuid())
  slug           String    @unique
  titleAr        String
  descriptionAr  String
  price          Int
  compareAtPrice Int?
  /// Copies on the shelf. Never below zero: a CHECK constraint (migration
  /// 20260917080000_quantity_checks) refuses it, and checkout takes copies
  /// with `takeFromShelf`, whose WHERE clause is the check, so two orders
  /// for the last copy cannot both succeed.
  stock          Int       @default(0)
  pages          Int
  publishedYear  Int
  languageAr     String    @default("العربية")
  coverUrl       String?
  tags           BookTag[] @default([])

  /// Denormalised for the listing pages; recomputed when reviews change.
  rating       Float @default(0)
  reviewsCount Int   @default(0)

  authorId    String
  categoryId  String
  publisherId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author        Author         @relation(fields: [authorId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  publisher     Publisher      @relation(fields: [publisherId], references: [id])
  reviews       Review[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]

  @@index([categoryId])
  @@index([authorId])
  @@index([publisherId])
  @@index([createdAt])
  @@map("books")
}

/// Lecture-note booklets (ملازم). A carbon copy of Book kept in its own
/// table on purpose: the two catalogues are managed and browsed apart, and
/// share only the author and publisher lookups — each files under its own
/// category tree.
model Handout {
  id             String    @id @default(cuid())
  slug           String    @unique
  titleAr        String
  descriptionAr  String
  price          Int
  compareAtPrice Int?
  /// Same CHECK and the same `takeFromShelf` as Book.stock.
  stock          Int       @default(0)
  pages          Int
  publishedYear  Int
  languageAr     String    @default("العربية")
  coverUrl       String?
  tags           BookTag[] @default([])

  /// Denormalised for the listing pages; recomputed when reviews change.
  rating       Float @default(0)
  reviewsCount Int   @default(0)

  authorId    String
  categoryId  String
  publisherId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author        Author                @relation(fields: [authorId], references: [id])
  category      HandoutCategory       @relation(fields: [categoryId], references: [id])
  publisher     Publisher             @relation(fields: [publisherId], references: [id])
  reviews       HandoutReview[]
  orderItems    HandoutOrderItem[]
  wishlistItems HandoutWishlistItem[]
  cartItems     HandoutCartItem[]

  @@index([categoryId])
  @@index([authorId])
  @@index([publisherId])
  @@index([createdAt])
  @@map("handouts")
}

// ------------------------------------------------------------------
// Customers
// ------------------------------------------------------------------

model Customer {
  id String @id @default(cuid())

  /// The Supabase Auth account (auth.users.id) behind this reader. The
  /// column is a real uuid with a foreign key to auth.users, written by hand
  /// in the migration because that table is outside Prisma's schema: deleting
  /// the account sets this null, and the next sign-in with the same email
  /// adopts the row again (see resolveCustomer in src/lib/auth.ts).
  userId String? @unique @db.Uuid

  name      String
  email     String         @unique
  phone     String
  /// Profile city, shown in the admin customer tables.
  city      String?
  birthDate DateTime?
  status    CustomerStatus @default(active)
  /// Grants access to /admin. Set deliberately, never on sign-up.
  role      CustomerRole   @default(customer)

  /// Marketing preferences, edited from /account.
  newsletterOptIn Boolean @default(true)
  offersOptIn     Boolean @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]
  cart      CartItem[]

  handoutReviews  HandoutReview[]
  handoutWishlist HandoutWishlistItem[]
  handoutCart     HandoutCartItem[]

  @@map("customers")
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  label       String
  fullName    String
  phone       String
  governorate String
  city        String
  line        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

// ------------------------------------------------------------------
// Orders
// ------------------------------------------------------------------

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique
  customerId String
  status     OrderStatus @default(pending)

  subtotal     Int
  shippingCost Int @default(0)
  discount     Int @default(0)
  total        Int

  paymentMethod  PaymentMethod
  shippingMethod ShippingMethod

  /// The delivery address is snapshotted: editing a saved address later
  /// must not rewrite the history of an order already placed.
  shippingName        String
  shippingPhone       String
  shippingGovernorate String
  shippingCity        String
  shippingLine        String
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  timeline OrderEvent[]

  handoutItems HandoutOrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  bookId    String
  quantity  Int    @default(1)
  /// Price at the moment of ordering, not the current catalogue price.
  unitPrice Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@index([bookId])
  @@map("order_items")
}

model OrderEvent {
  id         String      @id @default(cuid())
  orderId    String
  status     OrderStatus
  occurredAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

/// An order line for a handout. Orders hold both kinds of line side by side;
/// the two tables are kept apart because the two catalogues are.
model HandoutOrderItem {
  id        String @id @default(cuid())
  orderId   String
  handoutId String
  quantity  Int    @default(1)
  /// Price at the moment of ordering, not the current catalogue price.
  unitPrice Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  handout Handout @relation(fields: [handoutId], references: [id])

  @@index([orderId])
  @@index([handoutId])
  @@map("handout_order_items")
}

// ------------------------------------------------------------------
// Reviews, wishlist and cart
// ------------------------------------------------------------------

model Review {
  id         String       @id @default(cuid())
  bookId     String
  customerId String
  rating     Int
  title      String
  body       String
  status     ReviewStatus @default(pending)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// One review per book per reader.
  @@unique([bookId, customerId])
  @@index([status])
  @@map("reviews")
}

model WishlistItem {
  customerId String
  bookId     String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([customerId, bookId])
  @@map("wishlist_items")
}

model CartItem {
  customerId String
  bookId     String
  quantity   Int      @default(1)
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([customerId, bookId])
  @@map("cart_items")
}

// ------------------------------------------------------------------
// The same three, for handouts
// ------------------------------------------------------------------

model HandoutReview {
  id         String       @id @default(cuid())
  handoutId  String
  customerId String
  rating     Int
  title      String
  body       String
  status     ReviewStatus @default(pending)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  handout  Handout  @relation(fields: [handoutId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// One review per handout per reader.
  @@unique([handoutId, customerId])
  @@index([status])
  @@map("handout_reviews")
}

model HandoutWishlistItem {
  customerId String
  handoutId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  handout  Handout  @relation(fields: [handoutId], references: [id], onDelete: Cascade)

  @@id([customerId, handoutId])
  @@map("handout_wishlist_items")
}

model HandoutCartItem {
  customerId String
  handoutId  String
  quantity   Int      @default(1)
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  handout  Handout  @relation(fields: [handoutId], references: [id], onDelete: Cascade)

  @@id([customerId, handoutId])
  @@map("handout_cart_items")
}

// ------------------------------------------------------------------
// Marketing and store operations
// ------------------------------------------------------------------

model NewsletterSubscriber {
  email     String   @id
  /// Which storefront language the reader signed up in.
  locale    String   @default("ar")
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(new)
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model Coupon {
  id   String     @id @default(cuid())
  code String     @unique
  type CouponType @default(percentage)
  /// A percentage (1-100) or a flat amount in dinars, per `type`.
  value       Int
  /// Smallest cart subtotal the code applies to; 0 means no floor.
  minSubtotal Int        @default(0)
  active      Boolean    @default(true)
  expiresAt   DateTime?
  /// Null means unlimited.
  usageLimit  Int?
  usedCount   Int        @default(0)
  createdAt   DateTime   @default(now())

  @@map("coupons")
}

/// Free-form key/value store so the settings screen can persist without a
/// migration every time a field is added to it.
model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}
