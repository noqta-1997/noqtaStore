// Noqta Store — database schema, modelled from src/types/index.ts.
//
// Conventions
// - Editorial content (handouts, categories, authors) carries one column per
//   locale: the store ships exactly two, so a column pair beats a join.
// - Customer-written content (addresses, reviews) is a single column — a
//   reader types one string, not a translation pair.
// - Money is stored as whole Iraqi dinars; IQD has no minor units.
// - Enum values mirror the TypeScript unions exactly, so no mapping layer
//   is needed between Prisma Client and the existing app types.
//
// Connection URLs live in prisma7.config.ts (Prisma 7 removed them here).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum BookTag {
  bestseller
  new
  featured
  award
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  card
  wallet
}

enum ShippingMethod {
  standard
  express
  pickup
}

enum ReviewStatus {
  pending
  published
  rejected
}

enum CustomerStatus {
  active
  blocked
}

enum CustomerRole {
  customer
  admin
}

enum CouponType {
  percentage
  fixed
}

enum ContactStatus {
  new
  read
}

// ------------------------------------------------------------------
// Catalogue
// ------------------------------------------------------------------

/// The handouts' tree: stages hold grades, grades may hold branches, and any
/// of them may grow another level. A row with no parent is a top-level branch.
model HandoutCategory {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameAr        String
  descriptionAr String
  /// Lucide icon name; the UI layer owns the mapping.
  icon          String
  /// The branch this one hangs under; null for a top-level branch.
  parentId      String?
  /// Position among siblings — the grades read in school order, not by size.
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   HandoutCategory?  @relation("HandoutCategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children HandoutCategory[] @relation("HandoutCategoryTree")

  handouts Handout[]

  /// A name is unique among siblings: «العلمي» hangs under every preparatory
  /// grade, but never twice under the same one. The migration declares the
  /// index NULLS NOT DISTINCT so two top-level branches cannot share a name
  /// either — Postgres would otherwise treat each null parent as distinct.
  /// A second, spelling-blind key (migration 20260917160000_normalized_name_keys,
  /// which Prisma cannot declare) compares `arabic_key(nameAr)` instead, so
  /// «العلمى» is not a new sibling of «العلمي».
  @@unique([parentId, nameAr])
  @@index([parentId])
  @@map("handout_categories")
}

model Publisher {
  id            String   @id @default(cuid())
  slug          String   @unique
  /// The slug alone never caught a repeated name: the seeded slugs are Latin
  /// and a name typed into the panel makes an Arabic one, so «دار الشروق»
  /// re-entered used to become a second row. The name itself is the key —
  /// and, in the database, so is its spelling-blind form: a unique index on
  /// `arabic_key(nameAr)` (migration 20260917160000_normalized_name_keys,
  /// which Prisma cannot declare) treats «مكتبة» and «مكتبه» as one name.
  nameAr        String   @unique
  descriptionAr String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  handouts Handout[]

  @@map("publishers")
}

model Author {
  id        String   @id @default(cuid())
  slug      String   @unique
  /// Unique for the same reason as Publisher.nameAr, spelling-blind key
  /// included. Two teachers who really share a name are told apart by a
  /// suffix in the panel, not by a second row.
  nameAr    String   @unique
  bioAr     String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handouts Handout[]

  @@map("authors")
}

/// Lecture-note booklets (ملازم) — the store's catalogue. The table was a copy
/// of a school-book table dropped in migration 20260930120000_drop_books,
/// which is why the tag enum is still called BookTag.
model Handout {
  id             String    @id @default(cuid())
  slug           String    @unique
  titleAr        String
  descriptionAr  String
  price          Int
  /// The struck-through price before a discount. A CHECK (migration
  /// 20260929120000_title_figure_checks) holds it above `price`, or null.
  compareAtPrice Int?
  /// Copies on the shelf. Never below zero: a CHECK constraint (migration
  /// 20260917080000_quantity_checks) refuses it, and checkout takes copies
  /// with `takeFromShelf`, whose WHERE clause is the check, so two orders
  /// for the last copy cannot both succeed.
  stock          Int       @default(0)
  /// At least 1, by the same migration's CHECK.
  pages          Int
  /// 1 or later, by the same migration's CHECK. The upper bound — next year —
  /// moves with the clock, so the save actions hold it, not the table.
  publishedYear  Int
  languageAr     String    @default("العربية")
  coverUrl       String?
  tags           BookTag[] @default([])

  /// Denormalised for the listing pages; recomputed when reviews change.
  rating       Float @default(0)
  reviewsCount Int   @default(0)

  /// Set when the panel takes the title off sale without deleting it. A
  /// handout that has been ordered cannot be deleted — its order lines hold
  /// it — so archiving is how it leaves the shop: every storefront read
  /// filters on `archivedAt: null`, while order history and the panel still
  /// see it.
  archivedAt DateTime?

  authorId    String
  categoryId  String
  publisherId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author        Author                @relation(fields: [authorId], references: [id])
  category      HandoutCategory       @relation(fields: [categoryId], references: [id])
  publisher     Publisher             @relation(fields: [publisherId], references: [id])
  reviews       HandoutReview[]
  orderItems    HandoutOrderItem[]
  wishlistItems HandoutWishlistItem[]
  cartItems     HandoutCartItem[]

  @@index([categoryId])
  @@index([authorId])
  @@index([publisherId])
  @@index([createdAt])
  @@map("handouts")
}

// ------------------------------------------------------------------
// Customers
// ------------------------------------------------------------------

model Customer {
  id String @id @default(cuid())

  /// The Supabase Auth account (auth.users.id) behind this reader. The
  /// column is a real uuid with a foreign key to auth.users, written by hand
  /// in the migration because that table is outside Prisma's schema: deleting
  /// the account sets this null, and the next sign-in with the same email
  /// adopts the row again (see resolveCustomer in src/lib/auth.ts).
  userId String? @unique @db.Uuid

  name      String
  email     String         @unique
  phone     String
  /// Profile city, shown in the admin customer tables.
  city      String?
  birthDate DateTime?
  status    CustomerStatus @default(active)
  /// Grants access to /admin. Set deliberately, never on sign-up.
  role      CustomerRole   @default(customer)

  /// Marketing preferences, edited from /account.
  newsletterOptIn Boolean @default(true)
  offersOptIn     Boolean @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  addresses Address[]
  orders    Order[]

  handoutReviews  HandoutReview[]
  handoutWishlist HandoutWishlistItem[]
  handoutCart     HandoutCartItem[]

  @@map("customers")
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  label       String
  fullName    String
  phone       String
  governorate String
  city        String
  line        String
  /// At most one per customer: a partial unique index (migration
  /// 20260917140000_one_default_address, which Prisma cannot declare)
  /// refuses a second, and the writes in src/lib/addresses.ts run again
  /// when it does. None is allowed — the checkout then prefills the first.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

// ------------------------------------------------------------------
// Orders
// ------------------------------------------------------------------

model Order {
  id         String      @id @default(cuid())
  reference  String      @unique
  customerId String
  status     OrderStatus @default(pending)

  /// Dinars, whole. CHECKs (migration 20260917100000_money_and_rating_checks)
  /// keep each amount at or above zero, the discount at or below the
  /// subtotal, and total exactly subtotal + shippingCost - discount.
  subtotal     Int
  shippingCost Int @default(0)
  discount     Int @default(0)
  total        Int

  paymentMethod  PaymentMethod
  shippingMethod ShippingMethod

  /// The code whose use this order spent, so cancelling the order can give
  /// the use back and bringing it back can take it again. Null when none
  /// was applied — and on orders placed before the column existed.
  couponCode String?

  /// The delivery address is snapshotted: editing a saved address later
  /// must not rewrite the history of an order already placed.
  shippingName        String
  shippingPhone       String
  shippingGovernorate String
  shippingCity        String
  shippingLine        String
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id])
  timeline OrderEvent[]

  handoutItems HandoutOrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderEvent {
  id         String      @id @default(cuid())
  orderId    String
  status     OrderStatus
  occurredAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

/// An order line: one handout, how many, and the price it was sold at.
model HandoutOrderItem {
  id        String @id @default(cuid())
  orderId   String
  handoutId String
  quantity  Int    @default(1)
  /// Price at the moment of ordering, not the current catalogue price.
  unitPrice Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  handout Handout @relation(fields: [handoutId], references: [id])

  @@index([orderId])
  @@index([handoutId])
  @@map("handout_order_items")
}

// ------------------------------------------------------------------
// Reviews, wishlist and cart
// ------------------------------------------------------------------

model HandoutReview {
  id         String       @id @default(cuid())
  handoutId  String
  customerId String
  rating     Int
  title      String
  body       String
  status     ReviewStatus @default(pending)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  handout  Handout  @relation(fields: [handoutId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// One review per handout per reader.
  @@unique([handoutId, customerId])
  /// The unique index above leads with handoutId, so it serves a handout page
  /// but not "my reviews", nor the cascade when a customer row goes.
  @@index([customerId])
  @@index([status])
  @@map("handout_reviews")
}

model HandoutWishlistItem {
  customerId String
  handoutId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  handout  Handout  @relation(fields: [handoutId], references: [id], onDelete: Cascade)

  @@id([customerId, handoutId])
  /// The key leads with customerId; deleting a handout has to find its rows by handoutId.
  @@index([handoutId])
  @@map("handout_wishlist_items")
}

model HandoutCartItem {
  customerId String
  handoutId  String
  quantity   Int      @default(1)
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  handout  Handout  @relation(fields: [handoutId], references: [id], onDelete: Cascade)

  @@id([customerId, handoutId])
  /// Same as HandoutWishlistItem: the cascade from a deleted handout looks up handoutId.
  @@index([handoutId])
  @@map("handout_cart_items")
}

// ------------------------------------------------------------------
// Marketing and store operations
// ------------------------------------------------------------------

model NewsletterSubscriber {
  email     String   @id
  /// Which storefront language the reader signed up in.
  locale    String   @default("ar")
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(new)
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model Coupon {
  id   String     @id @default(cuid())
  code String     @unique
  type CouponType @default(percentage)
  /// A percentage (1-100) or a flat amount in dinars, per `type`.
  value       Int
  /// Smallest cart subtotal the code applies to; 0 means no floor.
  minSubtotal Int        @default(0)
  active      Boolean    @default(true)
  expiresAt   DateTime?
  /// Null means unlimited. A CHECK keeps usedCount at or below it, and
  /// checkout spends a use with `spendCoupon`, whose WHERE clause is the
  /// check, so two orders cannot both take the last one.
  usageLimit  Int?
  usedCount   Int        @default(0)
  createdAt   DateTime   @default(now())

  @@map("coupons")
}

/// Free-form key/value store so the settings screen can persist without a
/// migration every time a field is added to it.
model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}
